---
import { SITE_TITLE_DISPLAY, NAV_LINKS } from '../consts';

// Used to underline the nav item for the page you are currently on.
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/">{SITE_TITLE_DISPLAY}</a>

    <div class="site-header__end">
      <nav aria-label="Main">
        <ul class="nav">
          {
            NAV_LINKS.filter((link) => link.href !== '/').map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Both icons ship in the HTML and CSS shows the right one for the
          current data-theme, so the button never flashes the wrong glyph. */}
      <button id="theme-toggle" type="button" aria-label="Toggle theme">
        <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true">🌙</span>
        <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true">☀️</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    document
      .querySelector('[data-theme-color]')
      ?.setAttribute('content', next === 'dark' ? '#0d0d0c' : '#f6f2ec');
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-rule);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
  }

  /* The wordmark: full name, all caps, letter-spaced, serif, no logo mark. */
  .wordmark {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.7vw, 1.3rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--accent);
  }

  /* Nav and theme toggle share the right-hand side of the header. */
  .site-header__end {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    font-size: 0.95rem;
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    border-bottom-color: var(--accent);
    color: var(--accent);
  }

  /* Theme toggle: sized and weighted like a nav link, no chrome of its own. */
  #theme-toggle {
    font: inherit;
    font-size: 0.95rem;
    line-height: 1;
    background: none;
    border: 0;
    border-radius: 2px;
    padding: 0.3rem 0.35rem;
    cursor: pointer;
    color: inherit;
    opacity: 0.75;
    transition: opacity 0.18s ease;
  }

  #theme-toggle:hover {
    opacity: 1;
  }

  .theme-toggle__icon {
    display: none;
  }

  /* :global() because data-theme lives on <html>, outside this component. */
  :global(html:not([data-theme='dark'])) .theme-toggle__icon--light,
  :global(html[data-theme='dark']) .theme-toggle__icon--dark {
    display: inline;
  }

  /* On narrow screens the nav wraps to its own line under the wordmark. */
  @media (max-width: 34rem) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .wordmark {
      letter-spacing: 0.16em;
    }
  }
</style>
