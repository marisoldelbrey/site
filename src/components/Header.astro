---
import { SITE_TITLE_DISPLAY, NAV_LINKS } from '../consts';

// Used to underline the nav item for the page you are currently on.
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/">{SITE_TITLE_DISPLAY}</a>

    <nav aria-label="Main">
      <ul class="nav">
        {
          NAV_LINKS.filter((link) => link.href !== '/').map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-rule);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
  }

  /* The wordmark: full name, all caps, letter-spaced, serif, no logo mark. */
  .wordmark {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.7vw, 1.3rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--color-accent);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    font-size: 0.95rem;
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    border-bottom-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* On narrow screens the nav wraps to its own line under the wordmark. */
  @media (max-width: 34rem) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .wordmark {
      letter-spacing: 0.16em;
    }
  }
</style>
