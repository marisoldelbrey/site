---
import BaseLayout from '../layouts/BaseLayout.astro';
import { caseStudies, earlierExperience } from '../data/work.js';

// The earlier "Situation / What I built / Result" case-note markup this page
// replaced is kept at src/pages/_work.archived.astro (the underscore keeps it
// out of routing).
const featured = caseStudies.filter((s) => s.featured);
const gridStudies = caseStudies.filter((s) => !s.featured);
---

<BaseLayout
  title="Work"
  description="Selected engagements in automation, reporting, and firm operations."
>
  <section class="section work-intro">
    <div class="wrap">
      <p class="eyebrow">Work</p>
      <h1>Selected work.</h1>
    </div>
  </section>

  <section class="section work-list">
    <div class="wrap">
      <ul class="feature-list">
        {
          featured.map((study) => (
            <li class="feature-card">
              <div class="feature-card__text">
                <div class="case-card__head">
                  <h2 class="case-card__title">{study.title}</h2>
                  <span class={`status-badge status-${study.status}`}>
                    {study.label}
                  </span>
                </div>

                <p class="case-card__body">{study.description}</p>

                {study.stack.length > 0 && (
                  <p class="case-card__stack">{study.stack.join(' · ')}</p>
                )}
              </div>

              <figure class="feature-card__figure">
                <img
                  src={study.image.src}
                  alt={study.image.alt}
                  width={study.image.width}
                  height={study.image.height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </li>
          ))
        }
      </ul>

      <ul class="grid grid--3 case-grid">
        {
          gridStudies.map((study) => (
            <li class="case-card">
              <div class="case-card__head">
                <h2 class="case-card__title">{study.title}</h2>
                <span class={`status-badge status-${study.status}`}>
                  {study.label}
                </span>
              </div>

              <p class="case-card__body">{study.description}</p>

              {study.stack.length > 0 && (
                <p class="case-card__stack">{study.stack.join(' · ')}</p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section earlier">
    <div class="wrap">
      <h2 class="eyebrow">Earlier experience</h2>

      <ul class="earlier__list">
        {
          earlierExperience.map((role) => (
            <li class="earlier__item">
              <h3 class="earlier__role">{role.role}</h3>
              <p class="earlier__meta">
                {role.org} · {role.period}
              </p>
              <p class="earlier__body">{role.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section work-cta">
    <div class="wrap">
      <p class="lead">Want the longer version of any of these?</p>
      <a class="button button--accent" href="/contact/">Ask me about it</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* The eyebrow carries the page label, so the title itself does not need
     hero-sized type: --size-h1 tops out at 4rem, which is larger than the
     homepage hero (2.75rem). --size-h3 is the smallest step on the existing
     scale, which keeps this off a bespoke clamp. The display face and the
     eyebrow above it are what mark it as the page title now, not its size. */
  .work-intro h1 {
    font-size: var(--size-h3);
    /* Last element in the block, so its bottom margin would stack on top of
       the section padding below. */
    margin-bottom: 0;
  }

  /* The title block's padding met .work-list's top padding, roughly 8.5rem of
     combined space before the first card at desktop. Both sides are trimmed so
     the header block takes only the room it needs; .work-list's own top
     padding still separates it from the first card. */
  .work-intro {
    padding-top: clamp(1.25rem, 3vw, 2rem);
    padding-bottom: clamp(0.75rem, 2vw, 1.25rem);
  }

  .work-list,
  .earlier,
  .work-cta {
    border-top: 1px solid var(--color-rule);
  }

  /* Two lists, one card language. The featured pair runs full width with the
     image beside the text, so the screenshots are large enough to read; the
     rest sit in an even grid. Both share the surface, border, hover and inner
     type rules below. */
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .feature-card {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .feature-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
  }

  .feature-card__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .feature-card__figure {
    margin: 0;
    min-width: 0;
  }

  .feature-card__figure img {
    width: 100%;
    /* Screenshots are exported on a white canvas, so white sits behind them
       too: it only shows if an export ever carries transparency, where the
       card would otherwise read through the image. No aspect-ratio or
       object-fit - cropping a dashboard or a map cuts off its own legend. */
    background: #fff;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
  }

  .case-grid {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* .grid--3 steps straight from one column to three at 46rem, which leaves
     roughly 200px per card - too narrow for a title, badge and description.
     Hold two columns through the tablet band and take the third at 64rem, the
     same breakpoint the homepage stat strip uses for its final step. */
  @media (min-width: 46rem) and (max-width: 63.999rem) {
    .case-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Same surface treatment and hover lift as the homepage .next__card, so
     every card type on the site behaves identically. */
  .case-card,
  .feature-card {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .case-card:hover,
  .feature-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  /* Descriptions run from 110 to 361 characters, so cards left at their own
     height gave every row a ragged bottom. They stretch to a common height
     instead, and the stack line is pushed down with margin-top:auto so the
     rules line up across the row. */
  .case-card {
    display: flex;
    flex-direction: column;
  }

  /* Title and badge share a row; the badge drops below on very narrow cards. */
  .case-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.9rem;
  }

  .case-card__title {
    font-size: var(--size-h3);
    margin: 0;
    max-width: 22ch;
  }

  /* Optional card media. It sits below the head so the title and badge rows
     still line up across the grid row. Deliberately no aspect-ratio or
     object-fit: cropping a data visualization would cut off the map or its
     legend, so the image keeps its own proportions and the global `img` rule
     (max-width: 100%; height: auto) scales it down on narrow cards. */
  .case-card__figure {
    margin: 0 0 1.1rem;
  }

  .case-card__figure img {
    width: 100%;
    /* The chart is a Plotly export on a white canvas, so white is set behind
       it too: that only matters if the image is ever re-exported with
       transparency, where the dark card would otherwise show through the
       plot. The chart's own colors are left alone - dimming a data
       visualization would misrepresent the scale it exists to communicate. */
    background: #fff;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
  }

  .case-card__body {
    margin: 0;
    color: var(--text);
  }

  /* Matches the small uppercase label idiom used by .eyebrow and the contact
     list labels. */
  .case-card__stack {
    /* margin-top:auto bottom-aligns it, so the rule sits at the same height
       across a row of otherwise unequal text. */
    margin: 1.1rem 0 0;
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-warm-grey);
  }

  /* ---- Earlier experience ------------------------------------------------
     Deliberately steps down from the cards above: no surface, border or hover,
     just a rule down the left edge and smaller type, so it reads as supporting
     history rather than another case study. */
  .earlier__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(1.25rem, 3vw, 1.75rem);
    max-width: var(--measure);
  }

  .earlier__item {
    border-left: 1px solid var(--color-rule);
    padding-left: clamp(1rem, 3vw, 1.5rem);
  }

  .earlier__role {
    font-size: 1rem;
    margin: 0;
  }

  /* Same small uppercase label idiom as .case-card__stack and .eyebrow. */
  .earlier__meta {
    margin: 0.15rem 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-warm-grey);
  }

  .earlier__body {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text);
    opacity: 0.78;
  }

  .work-cta .lead {
    margin-bottom: 1.75rem;
  }
</style>
