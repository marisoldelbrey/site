---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

// Builds one static page per markdown file in src/content/writing.
export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'writing'> };

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedDate={post.data.pubDate}
>
  <article class="section">
    <div class="wrap">
      <header class="post-header">
        <p class="eyebrow">
          <a href="/writing/">Writing</a>
        </p>
        <h1>{post.data.title}</h1>
        <p class="post-header__meta">
          <FormattedDate date={post.data.pubDate} />
          {
            post.data.updatedDate && (
              <span class="post-header__updated">
                Updated <FormattedDate date={post.data.updatedDate} />
              </span>
            )
          }
        </p>
      </header>

      <div class="prose post-body">
        <Content />
      </div>

      <footer class="post-footer">
        <a href="/writing/">Back to all writing</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    max-width: var(--measure);
    margin-bottom: 2.5rem;
  }

  .post-header .eyebrow a {
    text-decoration: none;
  }

  .post-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
  }

  .post-header__updated {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-warm-grey);
  }

  /* Styles for the rendered markdown. `is:global` is needed because the HTML
     comes from the <Content /> component, not from this file. */
  .post-body :global(h2) {
    margin-top: 2.25em;
  }

  .post-body :global(h3) {
    margin-top: 1.75em;
  }

  .post-body :global(blockquote) {
    margin: 1.75em 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-accent);
    color: var(--color-warm-grey);
  }

  .post-body :global(li) {
    margin-bottom: 0.4em;
  }

  .post-body :global(img) {
    border-radius: 2px;
    margin-block: 2em;
  }

  .post-footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.9rem;
  }
</style>
