---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_TITLE_DISPLAY,
  SOCIAL_LINKS,
} from '../consts';
import { caseStudies } from '../data/work.js';

// The stat strip in section 02. `count` stats animate 0 -> value on scroll;
// the `transform` stat fades its outcome in beside the starting value instead.
// Markup always ships the final value, so the strip is correct with JS off or
// prefers-reduced-motion set.
const stats = [
  {
    kind: 'count',
    value: 36.1,
    prefix: '',
    suffix: '%',
    label: 'reduction in past-due AR following automation rollout',
  },
  {
    kind: 'count',
    value: 43925,
    prefix: '$',
    suffix: '+',
    label: 'documented value delivered across automation initiatives',
  },
  {
    kind: 'transform',
    from: '24hrs',
    to: 'instant',
    label: 'intake turnaround after automating the process',
  },
  {
    kind: 'count',
    value: 936,
    prefix: '',
    suffix: '',
    label:
      'automated outreach emails sent across three campaign lists in a single week',
  },
];

// Stat values may carry decimals (36.1%), so every render of a value - the
// server-rendered final one and each count-up frame - pins the same number of
// fraction digits. Otherwise the tick would round to a whole number and land
// on the wrong figure.
const decimalsOf = (n) => (String(n).split('.')[1] || '').length;

const formatStat = (s) =>
  `${s.prefix}${s.value.toLocaleString('en-US', {
    minimumFractionDigits: decimalsOf(s.value),
    maximumFractionDigits: decimalsOf(s.value),
  })}${s.suffix}`;

// Previews only. The full case studies live on /work/, and both read the same
// array, so these cannot drift from it. The first sentence of each description
// is enough for a one-line preview.
// A one-sentence description has no '. ' to split on, so the whole string
// comes back with its period already attached - only add one if it is missing.
const firstSentence = (text) => {
  const s = text.split('. ')[0].trim();
  return s.endsWith('.') ? s : s + '.';
};

const previews = caseStudies.slice(0, 3).map((study) => ({
  title: study.title,
  line: firstSentence(study.description),
  tags: study.previewTags ?? [],
}));

// One source for the numbered sections: the sidebar nav and the headings
// both read it, so a number cannot disagree between them. These are in-page
// anchors, which is what the scroll-spy below tracks; the remaining site
// pages stay reachable from the header nav on narrow screens and from the
// footer everywhere.
const sections = [
  { num: '01', label: 'About', id: 'about' },
  { num: '02', label: 'Impact', id: 'impact' },
  { num: '03', label: 'Work', id: 'work' },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="wrap home">
    {/* Left column. Sticky from 64rem up, a normal stacked block below that. */}
    <header class="home__aside">
      <div class="home__intro">
        <h1 class="home__name">{SITE_TITLE_DISPLAY}</h1>
        <p class="home__tagline">
          I build the operating systems behind professional services firms.
        </p>

        <nav class="home__nav" aria-label="Sections">
          <ul>
            {
              sections.map((section) => (
                <li>
                  <a href={`#${section.id}`} data-spy-link={section.id}>
                    <span class="home__nav-num">{section.num}.</span>
                    <span class="home__nav-label">{section.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      {/* Drawn with currentColor, so both follow the active theme with no
          per-theme color rules. Same paths as the header icons. */}
      <ul class="home__social">
        <li>
          <a
            href={SOCIAL_LINKS.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub (opens in a new tab)"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.82 1.1.82 2.22 0 1.6-.02 2.89-.02 3.29 0 .32.22.69.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            href={SOCIAL_LINKS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn (opens in a new tab)"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.44-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
              ></path>
            </svg>
          </a>
        </li>
      </ul>

      {/* Placeholder target: /resume.pdf is not in public/ yet, so this 404s
          until the file is added. */}
      <a class="home__resume" href="/resume.pdf">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v12M7 11l5 5 5-5M4 20h16" />
        </svg>
        Resume
      </a>

      {/* Scroll-spy. Marks whichever numbered section is crossing the middle of
          the viewport, so exactly one nav item is ever active. Pure
          IntersectionObserver, no scroll handler and no library.

          This script sits inside the sidebar, which the parser reaches BEFORE
          the sections it needs to observe, so it waits for the document rather
          than running inline. Without the wait every getElementById returns
          null, targets is empty, and the observer is never attached. */}
      <script is:inline>
        (() => {
          const init = () => {
          const links = Array.from(document.querySelectorAll('[data-spy-link]'));
          if (!links.length || !('IntersectionObserver' in window)) return;

          const targets = links
            .map((link) => document.getElementById(link.dataset.spyLink))
            .filter(Boolean);
          if (!targets.length) return;

          const visible = new Set();

          const setActive = (id) => {
            links.forEach((link) => {
              const on = link.dataset.spyLink === id;
              link.classList.toggle('is-active', on);
              // aria-current, not just a class: the active item is a real
              // position signal, not only a colour.
              if (on) link.setAttribute('aria-current', 'true');
              else link.removeAttribute('aria-current');
            });
          };

          const update = () => {
            if (!visible.size) return; // between bands: keep the last one lit
            // Topmost section wins, so scrolling up and down agree.
            const next = targets.find((el) => visible.has(el.id));
            if (next) setActive(next.id);
          };

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) visible.add(entry.target.id);
                else visible.delete(entry.target.id);
              });
              update();
            },
            // The band a section must touch to count as active. Trimming 20%
            // off the top and bottom leaves the middle 60% of the viewport, so
            // an item stays lit for most of the time its section is being read
            // rather than blinking as the heading crosses a hairline. Sections
            // overlap in a band this tall; update() keeps the topmost, so the
            // highlight moves on only once the previous section has left.
            { rootMargin: '-20% 0px -20% 0px', threshold: 0 }
          );

          targets.forEach((el) => observer.observe(el));
          setActive(targets[0].id);
          };

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init, { once: true });
          } else {
            init();
          }
        })();
      </script>
    </header>

    {/* Right column, scrolls normally. */}
    <div class="home__main">
      <section class="home__section" id="about" aria-labelledby="h-about">
        <h2 class="home__heading" id="h-about">
          <span class="home__num">{sections[0].num}.</span>
          <span>{sections[0].label}</span>
        </h2>

        <div class="home__prose">
          <p>
            I studied philosophy because I wanted to understand how systems of
            reasoning actually work, the logic underneath decisions, arguments,
            and institutions. That same instinct turned out to apply just as
            well to how organizations run.
          </p>
          <p>
            I paired that with a CS minor at Chapman University, then spent a
            year as an ML/AI Fellow through a competitive UCLA and Cornell
            program, selected from over 1,500 applicants. I built applied
            machine learning skills there, and learned how to translate complex
            model output into something a non-technical stakeholder could
            actually use and trust.
          </p>
          <p>
            Before Talley, I came at the same underlying question from a few
            different angles: how do you make complex systems legible and
            accountable? That meant operational inefficiencies in healthcare
            data workflows at Kaiser Permanente, a data-backed strategy that
            placed in the top 0.05% at Accenture's Innovation Challenge, and
            decades of California water data modeled as a research assistant at
            Chapman's Fowler School of Engineering.
          </p>
          <p>
            Now, as PMO Lead at Talley LLP, I bring all of that together.
            Reporting directly to the COO, I build the reporting
            infrastructure, CRM systems, and automation that a professional
            services firm actually runs on, and I direct associate-level
            support to help scale that delivery.
          </p>
          <p>Based in Orange County, California.</p>
        </div>
      </section>

      <section class="home__section" id="impact" aria-labelledby="h-impact">
        <h2 class="home__heading" id="h-impact">
          <span class="home__num">{sections[1].num}.</span>
          <span>{sections[1].label}</span>
        </h2>

        <ul class="stats__list" data-stats>
          {
            stats.map((stat) => (
              <li class="stat">
                {stat.kind === 'count' ? (
                  <p class="stat__value">
                    <span
                      data-count={stat.value}
                      data-decimals={decimalsOf(stat.value)}
                      data-prefix={stat.prefix}
                      data-suffix={stat.suffix}
                    >
                      {formatStat(stat)}
                    </span>
                  </p>
                ) : (
                  <p class="stat__value">
                    <span class="stat__from">{stat.from}</span>
                    <span class="stat__arrow" aria-hidden="true">
                      →
                    </span>
                    <span class="stat__to">{stat.to}</span>
                  </p>
                )}
                <p class="stat__label">{stat.label}</p>
              </li>
            ))
          }
        </ul>

        {/* Inline and directly after the strip so it runs during parse: it arms
            the start state before the browser paints this section, which is
            what keeps the final values from flashing before the animation
            begins. */}
        <script is:inline>
          (() => {
            const strip = document.querySelector('[data-stats]');
            if (!strip) return;

            const items = Array.from(strip.querySelectorAll('.stat'));
            const reduced = window.matchMedia(
              '(prefers-reduced-motion: reduce)'
            ).matches;

            // Reduced motion or no observer support: leave the server-rendered
            // final values exactly as they are.
            if (reduced || !('IntersectionObserver' in window)) return;

            items.forEach((el) => el.classList.add('is-armed'));

            const easeOut = (t) => 1 - Math.pow(1 - t, 3);

            const countUp = (el, target, prefix, suffix, decimals, duration) => {
              const started = performance.now();
              const step = (now) => {
                const t = Math.min((now - started) / duration, 1);
                const current = target * easeOut(t);
                el.textContent =
                  prefix +
                  current.toLocaleString('en-US', {
                    minimumFractionDigits: decimals,
                    maximumFractionDigits: decimals,
                  }) +
                  suffix;
                if (t < 1) requestAnimationFrame(step);
              };
              requestAnimationFrame(step);
            };

            // The strip sits in its own section now rather than under a hero
            // entrance, so there is nothing to wait out: reveal on sight.
            const reveal = (el) => {
              el.classList.add('is-visible');
              const num = el.querySelector('[data-count]');
              if (!num) return;
              countUp(
                num,
                Number(num.dataset.count),
                num.dataset.prefix || '',
                num.dataset.suffix || '',
                Number(num.dataset.decimals) || 0,
                1000
              );
            };

            const observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (!entry.isIntersecting) return;
                  // Once per stat, never again.
                  observer.unobserve(entry.target);
                  reveal(entry.target);
                });
              },
              { threshold: 0.35, rootMargin: '0px 0px -10% 0px' }
            );

            items.forEach((el) => observer.observe(el));
          })();
        </script>
      </section>

      <section class="home__section" id="work" aria-labelledby="h-work">
        <h2 class="home__heading" id="h-work">
          <span class="home__num">{sections[2].num}.</span>
          <span>{sections[2].label}</span>
        </h2>

        <p class="home__prose">
          Automation, reporting, and operations work.
        </p>

        <ul class="preview-list">
          {
            previews.map((project) => (
              <li class="preview">
                <h3 class="preview__title">{project.title}</h3>
                <p class="preview__line">{project.line}</p>

                {project.tags.length > 0 && (
                  <p class="preview__tags">{project.tags.join(' · ')}</p>
                )}
                <a class="preview__link" href="/work/">
                  View project
                  <svg
                    class="link-arrow"
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>

        {/* Same arm-then-reveal pattern as the stat strip above: the markup
            ships visible, and this only hides things once it has confirmed the
            browser will animate them back in. */}
        <script is:inline>
          (() => {
            const init = () => {
              const items = Array.from(document.querySelectorAll('.preview'));
              if (!items.length || !('IntersectionObserver' in window)) return;

              // Reduced motion: leave the server-rendered final state alone.
              if (
                window.matchMedia('(prefers-reduced-motion: reduce)').matches
              ) {
                return;
              }

              items.forEach((el) => el.classList.add('is-armed'));

              const observer = new IntersectionObserver(
                (entries) => {
                  entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    // Once per card, never again.
                    observer.unobserve(entry.target);
                    entry.target.classList.add('is-visible');
                  });
                },
                { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
              );

              items.forEach((el) => observer.observe(el));
            };

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', init, { once: true });
            } else {
              init();
            }
          })();
        </script>

        <a class="home__more" href="/work/">
          See all work
          <svg
            class="link-arrow"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* ---- Two-column shell --------------------------------------------------
     One column by default; the split and the sticky sidebar arrive together at
     64rem, the same breakpoint the rest of the site uses for its widest step. */
  .home {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    padding-block: var(--space-section);
  }

  @media (min-width: 64rem) {
    .home {
      grid-template-columns: minmax(0, 38fr) minmax(0, 62fr);
      gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }

    /* Plain sticky at a static offset: it starts where it sits in the flow and
       holds 2rem from the top once the page scrolls past it. No measured
       heights and nothing computed. */
    .home__aside {
      position: sticky;
      top: 2rem;
    }
  }

  /* ---- Sidebar -----------------------------------------------------------*/
  .home__name {
    font-size: clamp(1.45rem, 1.15rem + 1.15vw, 2rem);
    line-height: 1.1;
    margin: 0 0 0.6rem;
  }

  .home__tagline {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text);
    opacity: 0.72;
    max-width: 34ch;
    margin: 0;
  }

  .home__nav {
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  .home__nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  /* Vertical from the tablet band up; a wrapping row on phones, where a tall
     stack would push the first section below the fold. */
  @media (min-width: 46rem) {
    .home__nav ul {
      flex-direction: column;
      gap: 0.85rem;
    }
  }

  .home__nav a {
    --nav-pad: 0rem;
    position: relative;
    display: inline-flex;
    padding-block: var(--nav-pad);
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-warm-grey);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  /* Same mono face as the section header numbers. */
  .home__nav-num {
    font-family: var(--font-mono);
    font-size: 0.9em;
    letter-spacing: 0.06em;
  }

  /* Grows from the left edge on hover and stays out while an item is active.
     scaleX on a pseudo-element, so nothing reflows as it animates. */
  .home__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    /* Measured from the padding box, so it tracks --nav-pad and stays 0.4em
       under the text at every size. */
    bottom: calc(var(--nav-pad) - 0.4em);
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.25s ease;
  }

  .home__nav a:hover,
  .home__nav a:focus-visible,
  .home__nav a.is-active {
    color: var(--color-burgundy);
  }

  .home__nav a:hover::after,
  .home__nav a:focus-visible::after,
  .home__nav a.is-active::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .home__nav a::after {
      transition: none;
    }
  }

  .home__social {
    list-style: none;
    padding: 0;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    display: flex;
    gap: 1.1rem;
  }

  .home__social a {
    display: block;
    color: var(--color-warm-grey);
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .home__social a:hover,
  .home__social a:focus-visible {
    color: var(--accent);
    transform: translateY(-2px);
  }

  /* Stacked layout only: the nav sits immediately above "01. About", which
     repeats it. A hairline and extra space separate the two. The section
     headings stay put - the stacked nav scrolls away, so they are the only
     orientation cue once you are reading. */
  @media (max-width: 63.999rem) {
    .home__main {
      border-top: 1px solid var(--color-rule);
      padding-top: clamp(2rem, 7vw, 2.75rem);
    }

    /* Roomier touch targets: ~36px tall rather than ~15px. */
    .home__nav a {
      --nav-pad: 0.55rem;
    }

    .home__nav ul {
      gap: 0.35rem 1.6rem;
    }
  }

  /* ---- Numbered sections -------------------------------------------------*/
  .home__section + .home__section {
    margin-top: clamp(3rem, 8vw, 5.5rem);
  }

  .home__heading {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--size-h3);
    margin: 0 0 1.5rem;
  }

  /* Mono for the number, display face for the label, per the numbered-section
     convention. --font-mono is a system stack, so nothing extra downloads. */
  .home__num {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--accent);
  }

  .home__prose {
    max-width: var(--measure);
    margin: 0;
  }

  .home__prose p {
    margin: 0;
  }

  .home__prose p + p {
    margin-top: 1rem;
  }

  /* ---- Work previews -----------------------------------------------------
     A rule between entries rather than a card each: these point at the Work
     page, they are not the case studies themselves. */
  .preview-list {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: grid;
    gap: 1px;
    background: var(--color-rule);
    border-block: 1px solid var(--color-rule);
  }

  .preview {
    background: var(--bg);
    padding: 1.25rem 0.75rem;
    border-left: 2px solid transparent;
    transition: background 0.18s ease, border-color 0.18s ease;
  }

  .preview:hover {
    background: var(--color-surface);
    border-left-color: var(--color-burgundy);
  }

  /* ---- Preview entrance --------------------------------------------------
     .is-armed is added by the script above, so with JS off (or reduced motion)
     these rules never apply and the final state is what renders. */
  .preview.is-armed {
    opacity: 0;
    transform: translateY(14px);
  }

  /* The longhand keeps the hover transitions alive alongside the entrance one:
     a shorthand here would replace them, and a blanket transition-delay would
     also lag the hover wash by the stagger amount. */
  .preview.is-visible {
    opacity: 1;
    transform: none;
    transition-property: opacity, transform, background, border-color;
    transition-duration: 0.6s, 0.6s, 0.18s, 0.18s;
    transition-timing-function: ease;
  }

  .preview:nth-child(2).is-visible {
    transition-delay: 0.09s, 0.09s, 0s, 0s;
  }

  .preview:nth-child(3).is-visible {
    transition-delay: 0.18s, 0.18s, 0s, 0s;
  }

  .preview__title {
    font-size: 1.05rem;
    margin: 0 0 0.35rem;
  }

  /* Short skill tags, monospace like the other metadata on the site. */
  .preview__tags {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--color-warm-grey);
  }

