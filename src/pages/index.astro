---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// The stat strip below the hero. `count` stats animate 0 -> value on scroll;
// the `transform` stat fades its outcome in beside the starting value instead.
// Markup always ships the final value, so the strip is correct with JS off or
// prefers-reduced-motion set.
const stats = [
  {
    kind: 'count',
    value: 36.1,
    prefix: '',
    suffix: '%',
    label: 'reduction in past-due AR following automation rollout',
  },
  {
    kind: 'count',
    value: 43925,
    prefix: '$',
    suffix: '+',
    label: 'documented value delivered across automation initiatives',
  },
  {
    kind: 'transform',
    from: '24hrs',
    to: 'instant',
    label: 'intake turnaround after automating the process',
  },
  {
    kind: 'count',
    value: 936,
    prefix: '',
    suffix: '',
    label:
      'automated outreach emails sent across three campaign lists in a single week',
  },
];

// Stat values may carry decimals (36.1%), so every render of a value - the
// server-rendered final one and each count-up frame - pins the same number of
// fraction digits. Otherwise the tick would round to a whole number and land
// on the wrong figure.
const decimalsOf = (n) => (String(n).split('.')[1] || '').length;

const formatStat = (s) =>
  `${s.prefix}${s.value.toLocaleString('en-US', {
    minimumFractionDigits: decimalsOf(s.value),
    maximumFractionDigits: decimalsOf(s.value),
  })}${s.suffix}`;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Hero -->
  <section class="section hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <h1 class="hero__line">
          I build the operating systems behind professional services firms.
        </h1>

        <p class="hero__subhead">
          Combining PMO discipline with automation and AI that people actually
          use.
        </p>

        <p class="hero__support">
          Reporting directly to the COO, I support C-suite leadership across
          reporting, CRM, and process automation.
        </p>
        <p class="hero__support">
          I also direct associate-level support to scale delivery.
        </p>

        <div class="hero__actions">
          <a class="button button--accent" href="/work/">See the work</a>
          <a class="button" href="/contact/">Get in touch</a>
        </div>
      </div>

      <figure class="hero__figure">
        <img
          src="/images/marisol.jpg"
          alt="Marisol Delbrey"
          width="1920"
          height="1280"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- By the numbers -->
  <section class="section stats">
    <div class="wrap">
      <hr class="divider" />
      <h2 class="eyebrow">By the numbers</h2>

      <ul class="stats__list" data-stats>
        {
          stats.map((stat) => (
            <li class="stat">
              {stat.kind === 'count' ? (
                <p class="stat__value">
                  <span
                    data-count={stat.value}
                    data-decimals={decimalsOf(stat.value)}
                    data-prefix={stat.prefix}
                    data-suffix={stat.suffix}
                  >
                    {formatStat(stat)}
                  </span>
                </p>
              ) : (
                <p class="stat__value">
                  <span class="stat__from">{stat.from}</span>
                  <span class="stat__arrow" aria-hidden="true">
                    →
                  </span>
                  <span class="stat__to">{stat.to}</span>
                </p>
              )}
              <p class="stat__label">{stat.label}</p>
            </li>
          ))
        }
      </ul>

      {/* Inline and directly after the strip so it runs during parse: it arms
          the start state before the browser paints this section, which is what
          keeps the final values from flashing before the animation begins. */}
      <script is:inline>
        (() => {
          const strip = document.querySelector('[data-stats]');
          if (!strip) return;

          const items = Array.from(strip.querySelectorAll('.stat'));
          const reduced = window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          ).matches;

          // Reduced motion or no observer support: leave the server-rendered
          // final values exactly as they are.
          if (reduced || !('IntersectionObserver' in window)) return;

          items.forEach((el) => el.classList.add('is-armed'));

          const easeOut = (t) => 1 - Math.pow(1 - t, 3);

          const countUp = (el, target, prefix, suffix, decimals, duration) => {
            const started = performance.now();
            const step = (now) => {
              const t = Math.min((now - started) / duration, 1);
              const current = target * easeOut(t);
              el.textContent =
                prefix +
                current.toLocaleString('en-US', {
                  minimumFractionDigits: decimals,
                  maximumFractionDigits: decimals,
                }) +
                suffix;
              if (t < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          };

          // The hero entrance finishes ~960ms after load (0.41s delay + 0.55s
          // duration on the last item). The strip now sits directly under the
          // hero with tighter section spacing, so it is usually already on
          // screen at load and would otherwise start counting while the hero is
          // still moving. Hold it until the hero has settled. Anything revealed
          // later, by scrolling, has a wait of 0 and fires immediately.
          const HERO_SETTLE_MS = 960;
          const startedAt = performance.now();

          const reveal = (el) => {
            const wait = Math.max(
              0,
              HERO_SETTLE_MS - (performance.now() - startedAt)
            );
            window.setTimeout(() => {
              el.classList.add('is-visible');
              const num = el.querySelector('[data-count]');
              if (!num) return;
              countUp(
                num,
                Number(num.dataset.count),
                num.dataset.prefix || '',
                num.dataset.suffix || '',
                Number(num.dataset.decimals) || 0,
                1000
              );
            }, wait);
          };

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                // Once per stat, never again.
                observer.unobserve(entry.target);
                reveal(entry.target);
              });
            },
            { threshold: 0.35, rootMargin: '0px 0px -10% 0px' }
          );

          items.forEach((el) => observer.observe(el));
        })();
      </script>
    </div>
  </section>

  <!-- Links out -->
  <section class="section next">
    <div class="wrap">
      <hr class="divider" />
      <div class="grid grid--2">
        <a class="next__card" href="/writing/">
          <h2>Writing</h2>
          <p>Notes on the work, published as I go.</p>
          <span class="next__cue" aria-hidden="true">Read the writing</span>
        </a>
        <a class="next__card" href="/contact/">
          <h2>Contact</h2>
          <p>Tell me what you are trying to fix.</p>
          <span class="next__cue" aria-hidden="true">Start a conversation</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero entrance -----------------------------------------------------
     Above the fold, so this is a plain CSS animation rather than the observer
     the stat strip uses. animation-fill-mode: both holds the start state
     through the delay, so nothing flashes its final position first. */
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__line,
  .hero__subhead,
  .hero__support,
  .hero__actions,
  .hero__figure {
    animation: hero-in 0.55s ease both;
  }

  .hero__line {
    animation-delay: 0.05s;
  }
  .hero__subhead {
    animation-delay: 0.17s;
  }
  .hero__support {
    animation-delay: 0.23s;
  }
  .hero__actions {
    animation-delay: 0.29s;
  }
  .hero__figure {
    animation-delay: 0.41s;
  }

  /* The global reduced-motion rule only shortens durations, which would still
     leave these hidden through their delay. Drop the animation outright. */
  @media (prefers-reduced-motion: reduce) {
    .hero__line,
    .hero__subhead,
    .hero__support,
    .hero__actions,
    .hero__figure {
      animation: none;
    }
  }

  /* The hero was carrying a band of empty space below the buttons and photo:
     the section's own bottom padding, plus a bottom margin on the figure that
     only separates the stacked phone layout. Trim the padding, and drop the
     figure margin once the two columns sit side by side. */
  .hero {
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  @media (min-width: 52rem) {
    .hero__figure {
      margin-bottom: 0;
    }
  }

  /* Hero: single column on phones, text and image side by side on desktop. */
  .hero__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* Sized so the headline sits at three lines in the hero's text column at
     desktop widths, and two on a phone. */
  .hero__line {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.015em;
    max-width: 24ch;
    margin-bottom: 0.75rem;
  }

  /* Body face, regular weight, stepped back from the headline. Uses --text at
     reduced opacity rather than --color-warm-grey so it keeps AA contrast in
     both themes at this size. */
  .hero__subhead {
    font-family: var(--font-body);
    font-size: var(--size-lead);
    font-weight: 400;
    line-height: 1.5;
    color: var(--text);
    opacity: 0.72;
    max-width: 38ch;
    margin-bottom: 0.45rem;
  }

  /* Supporting detail under the subhead: smaller and muted so it recedes
     behind the subhead rather than competing with it. NOTE: --color-warm-grey
     measures 3.28:1 on --bg in the light theme, under the 4.5:1 WCAG AA floor
     for text this size. Dark theme is fine at 6.39:1. Requested deliberately;
     `color: var(--text); opacity: 0.62` reads about as muted and clears AA in
     both themes if this ever needs to pass an audit. */
  .hero__support {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-warm-grey);
    max-width: 60ch;
    margin: 0 0 0.2rem;
  }

  /* The gap before the buttons lives here rather than on the last line, so the
     two support lines stay a single tight block. */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }

  /* --tint is the knob for the photo treatment: raise for a stronger accent
     wash, set to 0 to turn it off entirely. soft-light keeps the photo's own
     contrast intact and just pulls it toward the palette. */
  .hero__figure {
    --tint: 0.18;
    position: relative;
    margin: 0;
  }

  .hero__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    mix-blend-mode: soft-light;
    opacity: var(--tint);
    border-radius: 2px;
    pointer-events: none;
  }

  /* The source photo is landscape (1920x1280 = 3:2). The slot is 4:3, close
     enough that cover trims ~11% off the sides as a deliberate crop instead of
     the ~47% the old 4:5 portrait slot was discarding. Keeping it near the
     source ratio is also what pulls the CTAs back above the fold, since this
     image is the tallest thing in the hero row. */
  .hero__figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 47% 40%;
    border-radius: 2px;
  }

  /* Section markers. These replace the full-width rules that used to separate
     the homepage sections: a short accent dash, aligned to the text column
     because it sits inside .wrap rather than on the section edge. */
  .divider {
    border: 0;
    width: 2rem;
    height: 2px;
    background: var(--accent);
    margin: 0 0 clamp(1.75rem, 3vw, 2.5rem);
  }

  /* Stat strip: one column on phones, two on tablets, four across on desktop. */
  .stats__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 46rem) {
    .stats__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .stats__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat {
    border-top: 1px solid var(--color-rule);
    padding-top: 1.1rem;
  }

  .stat__value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3em;
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--accent);
    margin: 0 0 0.6rem;
    /* Reserve the line box so the count-up cannot reflow the label. */
    min-height: 1.1em;
  }

  .stat__from {
    color: var(--text);
  }

  .stat__arrow {
    color: var(--color-warm-grey);
  }

  .stat__label {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text);
    opacity: 0.72;
  }

  /* ---- Scroll-in animation ----------------------------------------------
     .is-armed is added by the inline script above, so with JS off (or reduced
     motion) these rules never apply and the final state is what renders. */
  .stat.is-armed {
    opacity: 0;
    transform: translateY(14px);
  }

  .stat.is-visible {
    opacity: 1;
    transform: none;
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* Slight stagger when the whole strip enters together on desktop. */
  .stat:nth-child(2).is-visible {
    transition-delay: 0.08s;
  }
  .stat:nth-child(3).is-visible {
    transition-delay: 0.16s;
  }
  .stat:nth-child(4).is-visible {
    transition-delay: 0.24s;
  }

  /* The transformation stat: "24hrs" is already there, and the outcome fades
     in beside it once the card is revealed. */
  .stat.is-armed .stat__arrow,
  .stat.is-armed .stat__to {
    opacity: 0;
    transform: translateX(-6px);
  }

  .stat.is-visible .stat__arrow,
  .stat.is-visible .stat__to {
    opacity: 1;
    transform: none;
    transition: opacity 0.5s ease 0.35s, transform 0.5s ease 0.35s;
  }

  /* Links out */
  .next__card {
    display: block;
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .next__card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    color: inherit;
  }

  .next__card h2 {
    font-size: var(--size-h3);
    margin-bottom: 0.4rem;
  }

  .next__card p {
    color: var(--color-warm-grey);
    margin-bottom: 1rem;
  }

  .next__cue {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
